# The supplied local model directory. Override only if you move the model.
SCAMSHIELD_MODEL_DIR=scamshield_roberta
SCAMSHIELD_SCAM_LABEL_ID=
SCAMSHIELD_MODEL_DEVICE=auto

# Local LibreTranslate service (run on this computer; default is port 5010).
# Keep any managed-service API key on the backend; never put it in React.
TRANSLATION_API_URL=http://127.0.0.1:5010/translate
TRANSLATION_API_KEY=
TRANSLATION_API_TIMEOUT=30

# Local Marathi-to-English translation (downloads and caches the model on first Marathi scan).
# The default model is facebook/nllb-200-distilled-600M; set this to a local model path to avoid downloading.
SCAMSHIELD_MARATHI_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# Optional path. Defaults to backend/data/scamshield.db.
SCAMSHIELD_DATABASE_PATH=
